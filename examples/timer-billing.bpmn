<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" targetNamespace="http://example.camunda.python/timer">
  <bpmn:process id="periodic-billing" name="周期结算流程" isExecutable="true">
    <bpmn:startEvent id="billing-tick" name="周期触发">
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R3/PT2S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="charge" name="执行结算" camunda:delegateExpression="${charge}" />
    <bpmn:endEvent id="billing-done" name="结算完成" />
    <bpmn:sequenceFlow id="fb-tick" sourceRef="billing-tick" targetRef="charge" />
    <bpmn:sequenceFlow id="fb-charge" sourceRef="charge" targetRef="billing-done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="periodic-billing">
      <bpmndi:BPMNShape id="shape_charge" bpmnElement="charge">
        <dc:Bounds x="180" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_billing_tick" bpmnElement="billing-tick">
        <dc:Bounds x="60" y="133" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="56" y="175" width="45" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_billing_done" bpmnElement="billing-done">
        <dc:Bounds x="340" y="135" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="336" y="182" width="45" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_fb_tick" bpmnElement="fb-tick">
        <di:waypoint x="96" y="151" />
        <di:waypoint x="180" y="151" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_fb_charge" bpmnElement="fb-charge">
        <di:waypoint x="280" y="152" />
        <di:waypoint x="340" y="152" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
