<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  targetNamespace="http://camunda.example/mi">
  <!--
    M4-2c 演示流程：连锁门店「新品铺货」多实例三种宿主形态

    process batch-notify  —— serviceTask 宿主（并行）：一次向 N 个区域推送铺货
        通知。delegate 同步执行，无等待窗口：start 返回即全部实例完成并收束。
        collection=${regions}，elementVariable=region。

    process store-seq     —— subProcess 宿主（顺序）：门店逐家执行铺货子流程
        （店长人工确认 -> 收束）。同一时刻仅 1 家店在子流程内部停等，完成一
        家才续跑下一家。collection=${stores}，elementVariable=store。

    process store-par     —— subProcess 宿主（并行）+ completionCondition：
        3 家店同时进入子流程内部停等；任 2 家完成即满足条件 -> 剩余门店实例
        整树终止（内部人工任务一并取消归档）-> 容器收束离开。
  -->
  <bpmn:process id="batch-notify" name="区域铺货通知" isExecutable="true">
    <bpmn:startEvent id="startN"/>
    <bpmn:serviceTask id="batchNotify" name="区域铺货通知"
                      camunda:delegateExpression="${notifyRegion}">
      <bpmn:multiInstanceLoopCharacteristics camunda:collection="${regions}"
                                             camunda:elementVariable="region"/>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endN"/>
    <bpmn:sequenceFlow id="n1" sourceRef="startN" targetRef="batchNotify"/>
    <bpmn:sequenceFlow id="n2" sourceRef="batchNotify" targetRef="endN"/>
  </bpmn:process>

  <bpmn:process id="store-seq" name="门店铺货（顺序）" isExecutable="true">
    <bpmn:startEvent id="startS"/>
    <bpmn:subProcess id="storeSeq" name="单店铺货子流程">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true"
                                             camunda:collection="${stores}"
                                             camunda:elementVariable="store"/>
      <bpmn:startEvent id="innerStartS"/>
      <bpmn:userTask id="storeApproveS" name="店长人工确认"/>
      <bpmn:endEvent id="innerEndS"/>
      <bpmn:sequenceFlow id="s1" sourceRef="innerStartS" targetRef="storeApproveS"/>
      <bpmn:sequenceFlow id="s2" sourceRef="storeApproveS" targetRef="innerEndS"/>
    </bpmn:subProcess>
    <bpmn:endEvent id="endS"/>
    <bpmn:sequenceFlow id="s3" sourceRef="startS" targetRef="storeSeq"/>
    <bpmn:sequenceFlow id="s4" sourceRef="storeSeq" targetRef="endS"/>
  </bpmn:process>

  <bpmn:process id="store-par" name="门店铺货（并行抢跑）" isExecutable="true">
    <bpmn:startEvent id="startP"/>
    <bpmn:subProcess id="storePar" name="单店铺货子流程">
      <bpmn:multiInstanceLoopCharacteristics camunda:collection="${stores}"
                                             camunda:elementVariable="store">
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">${nrOfCompletedInstances &gt;= 2}</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="innerStartP"/>
      <bpmn:userTask id="storeApproveP" name="店长人工确认"/>
      <bpmn:endEvent id="innerEndP"/>
      <bpmn:sequenceFlow id="p1" sourceRef="innerStartP" targetRef="storeApproveP"/>
      <bpmn:sequenceFlow id="p2" sourceRef="storeApproveP" targetRef="innerEndP"/>
    </bpmn:subProcess>
    <bpmn:endEvent id="endP"/>
    <bpmn:sequenceFlow id="p3" sourceRef="startP" targetRef="storePar"/>
    <bpmn:sequenceFlow id="p4" sourceRef="storePar" targetRef="endP"/>
  </bpmn:process>
</bpmn:definitions>
